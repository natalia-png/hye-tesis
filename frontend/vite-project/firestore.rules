rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUid()    { return request.auth.uid; }
    function myEmail()  { return request.auth.token.email; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.role == "admin";
    }

    function isColaborador() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && get(/databases/$(database)/documents/users/$(myUid())).data.role == "colaborador";
    }

    function isClientOfProject(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == myUid()
          || get(/databases/$(database)/documents/projects/$(projectId)).data.clientEmail == myEmail()
        );
    }

    /* ---------------- USUARIOS ---------------- */
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer perfiles de admin o colaborador (para iniciar chats)
      allow read: if signedIn() && (myUid() == userId || isAdmin() || isColaborador() || resource.data.role == "admin" || resource.data.role == "colaborador");
      allow create, update, delete: if isAdmin();
      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && myUid() == userId;
      }
    }

    /* ---------------- PROYECTOS ---------------- */
    match /projects/{projectId} {
      allow read: if isAdmin()
        || isColaborador()
        || (
          signedIn()
          && (
            resource.data.clientId    == myUid()
            || resource.data.clientEmail == myEmail()
          )
        );

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isColaborador()
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["fases", "progress", "updatedAt", "chatPermisos"])
        );

      match /fases/{faseId} {
        allow read: if isAdmin() || isColaborador() || isClientOfProject(projectId);
        allow write: if isAdmin() || isColaborador();
        match /notas/{notaId} {
          allow read: if isAdmin() || isColaborador() || isClientOfProject(projectId);
          allow write: if isAdmin() || isColaborador();
        }
        match /archivos/{archivoId} {
          allow read: if isAdmin()
            || isColaborador()
            || (isClientOfProject(projectId) && resource.data.visibleToClient == true);
          allow write: if isAdmin() || isColaborador();
        }
      }
    }

    /* ---------------- DOCUMENTOS DE PROYECTO ---------------- */
    match /projectDocuments/{docId} {
      allow read, write: if isAdmin();
      allow read: if signedIn()
        && (resource.data.projectId is string)
        && isClientOfProject(resource.data.projectId);
    }

    /* ---------------- NOTIFICACIONES ---------------- */
    match /notifications/{userId}/items/{notifId} {
      allow read, update: if signedIn() && myUid() == userId;
      allow create: if signedIn();
      allow delete:  if signedIn() && myUid() == userId;
    }

    /* ---------------- GARANTÍAS ---------------- */
    match /garantias/{projectId}/solicitudes/{solicitudId} {
      allow read, create: if signedIn();
      allow update: if isAdmin()
        || isColaborador()
        || (signedIn() && myUid() == resource.data.creadoPor);
      allow delete: if isAdmin();
    }

    /* ---------------- SOLICITUDES COMERCIALES ---------------- */
    match /solicitudesComerciales/{solicitudId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    /* ---------------- CHATS ---------------- */
    match /chats/{chatId} {
      // get: admin, doc inexistente (para verificar antes de crear), o participante
      allow get: if isAdmin()
        || resource == null
        || request.auth.uid in resource.data.participants;

      // list: hasAny() es reconocido por el validador de queries array-contains
      allow list: if isAdmin()
        || resource.data.participants.hasAny([request.auth.uid]);

      // create: el usuario debe estar en los participantes del nuevo doc
      allow create: if isAdmin()
        || request.auth.uid in request.resource.data.participants;

      // update: solo participantes actuales o admin
      allow update: if isAdmin()
        || request.auth.uid in resource.data.participants;

      // Mensajes: get() al padre está permitido (es documento distinto)
      match /messages/{messageId} {
        allow read, create: if isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

  }
}
