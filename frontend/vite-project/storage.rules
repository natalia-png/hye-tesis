rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function myUid()    { return request.auth.uid; }
    function myEmail()  { return request.auth.token.email; }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(myUid())).data.role;
    }

    function isAdmin() {
      return signedIn()
        && myEmail() == "hyearquitectos@gmail.com"
        || (signedIn()
          && firestore.exists(/databases/(default)/documents/users/$(myUid()))
          && userRole() == "admin");
    }

    function isColaborador() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(myUid()))
        && userRole() == "colaborador";
    }

    function isClientOfProject(projectId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && (
          firestore.get(/databases/(default)/documents/projects/$(projectId)).data.clientId == myUid()
          || firestore.get(/databases/(default)/documents/projects/$(projectId)).data.clientEmail == myEmail()
        );
    }

    function isVisiblePhaseFile(projectId, faseId, fileId) {
      return firestore.exists(/databases/(default)/documents/projects/$(projectId)/fases/$(faseId)/archivos/$(fileId))
        && firestore.get(/databases/(default)/documents/projects/$(projectId)/fases/$(faseId)/archivos/$(fileId)).data.visibleToClient == true;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*');
    }

    function isSmallEnough() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024;
    }

    /* ── Fotos de perfil ── */
    match /profilePhotos/{userId}/{fileName=**} {
      allow read: if signedIn();
      allow write, delete: if signedIn()
        && myUid() == userId
        && isImage()
        && isSmallEnough();
    }

    /* ── Archivos de fases ── */
    match /phaseFiles/{projectId}/{faseId}/{fileId} {
      allow read, write, delete: if isAdmin() || isColaborador();
      allow read: if isClientOfProject(projectId) && isVisiblePhaseFile(projectId, faseId, fileId);
    }

    /* ── Archivos de garantías ── */
    match /garantias/{projectId}/{fileName=**} {
      allow read, write, delete: if signedIn();
    }

    match /garantias/{projectId}/respuestas/{fileName=**} {
      allow read, write, delete: if signedIn();
    }

    /* ── Bloquear todo lo demás ── */
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
